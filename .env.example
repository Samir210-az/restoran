AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai

# ==============================
# ODENIS (Faza 6-da aktivlesecek)
# ==============================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYRIFF_MERCHANT_ID=
PAYRIFF_SECRET_KEY=

# ==============================
# TETBIQ
# ==============================
